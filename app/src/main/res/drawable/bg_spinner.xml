<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <stroke android:width="1dp" android:color="?attr/colorOutline" />
            <corners android:radius="@dimen/input_corner_radius" />
            <solid android:color="?attr/colorSurface" />
        </shape>
    </item>
    <item android:right="12dp" android:gravity="center_vertical|right">
        <bitmap android:src="@android:drawable/arrow_down_float" android:tint="?attr/colorPrimary" />
    </item>
</layer-list>
