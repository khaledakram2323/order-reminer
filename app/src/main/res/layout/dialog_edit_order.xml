<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editDialogRootCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardPreventCornerOverlap="true"
    app:strokeColor="#00A8E8"
    app:strokeWidth="2dp"
    android:layoutDirection="rtl">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:maxHeight="520dp"
        app:layout_constrainedHeight="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvEditTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تعديل الأوردر"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="12dp" />

            <!-- Customer Code -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEditCustomerCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="كود العميل"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:boxStrokeColor="@color/text_input_box_stroke"
                app:hintTextColor="@color/brand_cyan"
                android:layout_marginBottom="8dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEditCustomerCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Phone -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEditPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="رقم التليفون"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:boxStrokeColor="@color/text_input_box_stroke"
                app:hintTextColor="@color/brand_cyan"
                android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEditPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Order Type -->
            <TextView
                android:id="@+id/tvEditTypeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="نوع الأوردر"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleEditOrderType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@id/btnEditDelivery"
                android:layout_marginBottom="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditDelivery"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="توصيل"
                    app:strokeColor="@color/brand_cyan"
                    app:backgroundTint="@color/toggle_btn_bg"
                    android:textColor="@color/toggle_btn_text"
                    style="@style/Widget.Material3.Button.OutlinedButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditPickup"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="استلام"
                    app:strokeColor="@color/brand_cyan"
                    app:backgroundTint="@color/toggle_btn_bg"
                    android:textColor="@color/toggle_btn_text"
                    style="@style/Widget.Material3.Button.OutlinedButton" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Priority -->
            <TextView
                android:id="@+id/tvEditPriorityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الأولوية"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleEditPriorityGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@id/btnEditPriorityNormal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditPriorityNormal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="عادي"
                    app:strokeColor="@color/brand_cyan"
                    app:backgroundTint="@color/toggle_btn_bg"
                    android:textColor="@color/toggle_btn_text"
                    style="@style/Widget.Material3.Button.OutlinedButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditPriorityUrgent"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="مستعجل"
                    app:strokeColor="@color/brand_cyan"
                    app:backgroundTint="@color/toggle_btn_bg"
                    android:textColor="@color/toggle_btn_text"
                    style="@style/Widget.Material3.Button.OutlinedButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditPriorityShortage"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="نواقص"
                    app:strokeColor="@color/brand_cyan"
                    app:backgroundTint="@color/toggle_btn_bg"
                    android:textColor="@color/toggle_btn_text"
                    style="@style/Widget.Material3.Button.OutlinedButton" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Date & Time -->
            <TextView
                android:id="@+id/tvEditTimeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="وقت التذكير"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">
                <Button
                    android:id="@+id/btnEditDate"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="تعديل التاريخ"
                    app:strokeColor="@color/brand_cyan"
                    android:textColor="?attr/colorOnSurface" />
                <TextView
                    android:id="@+id/tvEditDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="اليوم"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <Button
                    android:id="@+id/btnEditTime"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="تعديل الوقت"
                    app:strokeColor="@color/brand_cyan"
                    android:textColor="?attr/colorOnSurface" />
                <TextView
                    android:id="@+id/tvEditTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="الآن"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- Items -->
            <TextView
                android:id="@+id/tvEditItemsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الأصناف"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:id="@+id/editItemsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="4dp"/>

            <Button
                android:id="@+id/btnEditAddItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.Material3.Button.TextButton"
                android:text="+ إضافة صنف"
                android:textColor="?attr/colorPrimary"
                android:layout_gravity="start"
                android:layout_marginBottom="8dp" />

            <!-- Notes -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEditNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="الملاحظات"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:boxStrokeColor="@color/text_input_box_stroke"
                app:hintTextColor="@color/brand_cyan"
                android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEditNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnEditSave"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:text="حفظ التعديلات"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:backgroundTint="#00A8E8"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</com.google.android.material.card.MaterialCardView>